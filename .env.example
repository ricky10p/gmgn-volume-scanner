# ============================================================
#  GMGN Volume Scanner — template konfigurasi
#  Salin file ini:  cp .env.example .env  &&  chmod 600 .env
# ============================================================

# --- Mode koneksi GMGN ---
# public  = tanpa API key (pakai HTTP/2 + TLS fingerprint Chrome, lihat src/h2.js)
# openapi = endpoint resmi, butuh GMGN_API_KEY dari https://gmgn.ai/ai
GMGN_MODE=public
GMGN_CHAIN=sol
GMGN_PERIOD=1m
GMGN_ORDERBY=volume
GMGN_LIMIT=100
GMGN_POLL_MS=5000

# --- Mode tabel (src/monitor.js) ---
GMGN_MIN_VOLUME=0
GMGN_ALERT_USD=5000
GMGN_ALERT_PCT=15

# --- Filter scanner (dipakai channel 1 DAN channel 2) ---
GMGN_MIN_VOL_USD=20000
GMGN_MIN_FEE_SOL=3
GMGN_MIN_MCAP_USD=100000

# --- Channel 1 (volume spike) ---
GMGN_COOLDOWN_MIN=5          # jeda per token setelah terkirim (menit)
GMGN_DELETE_AFTER_MIN=5      # hapus pesan setelah N menit (0 = simpan; maks 48 jam)

# --- Tampilan pool ---
# GMGN_MAX_POOLS=            # kosong = tampilkan semua pool DLMM
GMGN_MIN_POOL_TVL=0          # sembunyikan pool dengan TVL di bawah nilai ini
# GMGN_POOL_TYPES=dlmm       # atau dlmm,damm
# GMGN_REQUIRE_POOL=0        # 0 = tetap kirim walau token tanpa pool DLMM
# GMGN_DRY_RUN=1             # 1 = cetak saja, tidak kirim ke Telegram

GMGN_LANG=id
GMGN_TZ=Asia/Jakarta

# ============================================================
#  TELEGRAM
# ============================================================

# --- Channel 1: volume spike ---
# Bot: buat di @BotFather. Chat ID: kirim pesan ke bot, lalu jalankan
#   node scripts/tg_discover.mjs
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Channel 2: volume bertahan ---
# Bot KEDUA, terpisah dari channel 1. Kosongkan kalau tidak dipakai.
# TG2_BOT_TOKEN=
# TG2_CHAT_ID=
TG2_MIN_VOL_USD=50000        # ambang volume 1 menit
TG2_SUSTAIN_MIN=3            # harus bertahan di atas ambang selama N menit
TG2_REPEAT_SEC=5             # kirim ulang tiap N detik selama masih di atas ambang
TG2_DELETE_AFTER_SEC=30      # hapus tiap pesan setelah N detik
TG2_MAX_PER_CYCLE=10         # batas jumlah token yang dikirim per siklus (anti-flood)

# Catatan: filter fee & market cap channel 2 mengikuti GMGN_MIN_FEE_SOL
# dan GMGN_MIN_MCAP_USD di atas, bukan variabel sendiri.

# ============================================================
#  OPSIONAL
# ============================================================
# GMGN_WATCH=mint1,mint2     # pantau mint tertentu saja (mode tabel)
# GMGN_OUT_DIR=./data        # lokasi file state & log
# GMGN_COOKIE=               # cookie cf_clearance kalau kena rate limit
# GMGN_PROXY=http://user:pass@host:port   # proxy HTTP CONNECT
# GMGN_API_KEY=              # hanya untuk GMGN_MODE=openapi
# GMGN_CLIENT_ID=            # hanya untuk GMGN_MODE=openapi

# public = no key, works via HTTP/2 + Chrome TLS fingerprint (see src/h2.js)
# openapi = official endpoint, needs GMGN_API_KEY from https://gmgn.ai/ai
GMGN_MODE=public
GMGN_CHAIN=sol
GMGN_PERIOD=1m
GMGN_ORDERBY=volume
GMGN_LIMIT=100
GMGN_POLL_MS=5000

# table mode (src/monitor.js)
GMGN_MIN_VOLUME=0
GMGN_ALERT_USD=5000
GMGN_ALERT_PCT=15

# scanner mode (src/scan.js)
GMGN_MIN_VOL_USD=20000
GMGN_MIN_FEE_SOL=3
GMGN_MIN_MCAP_USD=100000
GMGN_COOLDOWN_MIN=5
GMGN_DELETE_AFTER_MIN=5      # 0 = never delete; Telegram caps bot deletions at 48h
# GMGN_MAX_POOLS=       # unset = list every DLMM pool
GMGN_MIN_POOL_TVL=0
# GMGN_POOL_TYPES=dlmm        # or dlmm,damm
# GMGN_REQUIRE_POOL=0        # set 0 to also alert tokens without a DLMM pool
# GMGN_DRY_RUN=1

GMGN_LANG=id
GMGN_TZ=Asia/Jakarta

# telegram delivery for the scanner (both required)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# optional
# GMGN_WATCH=mint1,mint2
# GMGN_COOKIE=
# GMGN_API_KEY=
